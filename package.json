{
  "name": "luxury-os",
  "version": "0.1.0",
  "private": true,
  "description": "Unified Fine-Dining, Luxury & Palace Operating System",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
